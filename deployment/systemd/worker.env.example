# ==============================================================================
# Agent Platform - Production Temporal Worker Environment Configuration
# ==============================================================================
# Security requirement:
# Copy this file to /etc/agent-platform/worker.env and set restrictive permissions:
#   sudo install -m 600 -o agentplatform -g agentplatform worker.env /etc/agent-platform/worker.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TEMPORAL CLUSTER TARGET
# ------------------------------------------------------------------------------
# [Option A: Local Development / Staging Test Server]
# Uncomment for a local or development environment:
# TEMPORAL_TARGET_HOST=localhost:7233
# TEMPORAL_NAMESPACE=default

# [Option B: Self-Hosted Production Temporal Cluster (Default)]
# Hostname or IP with port of your internal Temporal frontend service:
TEMPORAL_TARGET_HOST=temporal-frontend.internal:7233
TEMPORAL_NAMESPACE=production

# [Option C: Temporal Cloud]
# When using Temporal Cloud, specify the cloud namespace endpoint:
# TEMPORAL_TARGET_HOST=my-company.a1b2c.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=my-company.a1b2c
# TEMPORAL_TLS_CERT_PATH=/etc/agent-platform/certs/temporal-client.crt
# TEMPORAL_TLS_KEY_PATH=/etc/agent-platform/certs/temporal-client.key

# ------------------------------------------------------------------------------
# 2. TASK QUEUE & WORKER SCALING SETTINGS
# ------------------------------------------------------------------------------
# Task queue name that Workers poll for workflow and activity tasks:
TEMPORAL_TASK_QUEUE=agent-platform-queue

# Maximum concurrent activities a single Worker process will execute simultaneously:
TEMPORAL_WORKER_CONCURRENCY=10

# Activity timeout in seconds:
TEMPORAL_ACTIVITY_TIMEOUT_SECONDS=120

# Maximum automatic retries for transient activity failures:
TEMPORAL_ACTIVITY_MAX_RETRIES=3

# Graceful drain timeout in seconds when stopping/restarting (must be less than systemd TimeoutStopSec=60s):
TEMPORAL_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 3. DATABASE & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Explicit absolute path to the shared SQLite database file:
AGENT_PLATFORM_DB_PATH=/var/lib/agent-platform/agent_platform.db

# Set to "production" to enforce strict database pre-existence checks:
AGENT_PLATFORM_ENV=production

# Execution backend used by the platform:
AGENT_PLATFORM_EXECUTION_BACKEND=temporal

