AGENT_PLATFORM_DB_PATH=agent_platform.db
GEOSTRATA_DB_PATH=geostrata.db
AGENT_PLATFORM_LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Generic Plugin and Workflow Discovery
# Semicolon- or comma-separated directories to discover external plugins & workflows
AGENT_PLATFORM_PLUGIN_DIRS=./plugins/manifests;./geostrata/plugins/manifests
AGENT_PLATFORM_WORKFLOW_DIRS=./workflow_definitions;./geostrata/workflow_definitions

# Security: Trusted Python package prefixes for plugin entrypoints (comma- or semicolon-separated)
AGENT_PLATFORM_TRUSTED_NAMESPACES=plugins.,geostrata.plugins.


