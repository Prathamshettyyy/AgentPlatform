# GeoStrata Backend URL (default: 8001)
VITE_API_BASE_URL=http://127.0.0.1:8001

# Optional Bearer authentication token when GeoStrata runs in static/jwt auth mode
VITE_API_AUTH_TOKEN=

# Optional link to existing Agent Platform dashboard for internal monitoring
VITE_AGENT_PLATFORM_UI_URL=http://localhost:5173

